# ─── THE 87TH CLUB — environment ──────────────────────────────────────────────
# Copy to .env (local) or set in your host's dashboard (production).
# Never commit real values.

# PostgreSQL connection string (required)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/club87"

# Long random string (32+ chars) used to sign admin sessions (required)
# e.g. `openssl rand -base64 48`
AUTH_SECRET=""

# Public URL of the store, no trailing slash (required in production)
SITE_URL="https://www.the87thclub.com"
NEXT_PUBLIC_SITE_URL="https://www.the87thclub.com"

# ISO currency for prices and payments. Paystack Kenya settles in KES.
STORE_CURRENCY="KES"

# ─── Payments: Paystack (cards, M-Pesa, mobile money, bank) ───────────────────
# Dashboard → Settings → API Keys & Webhooks. Use sk_test_… while testing.
# Webhook URL to set in Paystack: https://<your-domain>/api/webhooks/paystack
PAYSTACK_SECRET_KEY=""
# Minutes stock is held for an unpaid checkout before it is released
RESERVATION_MINUTES=30

# ─── Email (order confirmations, shipping updates, contact form) ──────────────
# Any SMTP provider: Gmail Workspace, Postmark, SendGrid, Mailgun, Zoho…
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="THE 87TH CLUB <orders@the87thclub.com>"
# Where new paid-order alerts go (optional)
ORDER_NOTIFY_EMAIL=""
# Where contact-form messages go (optional; defaults to the support email set in Admin → Settings)
CONTACT_TO_EMAIL=""

# ─── Image storage ────────────────────────────────────────────────────────────
# Local disk (default). Must be a persistent volume in production.
UPLOAD_DIR="./storage"
# …or any S3-compatible bucket (AWS S3, Cloudflare R2, DigitalOcean Spaces).
# When S3_BUCKET is set, uploads go to the bucket instead of the disk.
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""            # e.g. https://<account>.r2.cloudflarestorage.com (leave empty for AWS)
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""     # public URL of the bucket / CDN, e.g. https://media.the87thclub.com
