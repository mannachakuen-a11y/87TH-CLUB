# ==================================================================
# THE 87TH CLUB — server environment. Copy to server/.env (or export).
# Default driver is local SQL (data/87th.sqlite). Set DRIVER=supabase
# and supply your Supabase credentials to use Postgres instead.
# ==================================================================

# ----- server -----
PORT=8787
JWT_SECRET=change-me-to-a-long-random-string
DRIVER=sqlite            # sqlite | supabase
# DB_FILE=data/87th.sqlite

# ----- AI providers (any that you set becomes available via the router) -----
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIza...
# MISTRAL_API_KEY=...

# ----- Google OAuth (sign-in via "Continue with Google" + Gmail sending) -----
# Create an OAuth 2.0 Client ID in Google Cloud Console (category "Web app"),
# then add the exact callback below as an Authorized redirect URI.
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/auth/google/callback
# Origin the app redirects back to after sign-in (defaults to http://localhost:5173).
# APP_ORIGIN=http://localhost:5173
# Note: the flow requests openid/email/profile + gmail.send and gmail.readonly
# so a verified Gmail connection can genuinely send client messages.

# ----- Supabase (only if DRIVER=supabase) -----
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=...
# SUPABASE_SERVICE_ROLE_KEY=...   # server-only; never sent to the browser

# ----- Shopify / Stripe / GA4 (as you enable them) -----
# SHOPIFY_DOMAIN=...
# SHOPIFY_ADMIN_TOKEN=...
# STRIPE_SECRET_KEY=...
# GOOGLE_ANALYTICS_JSON=...
